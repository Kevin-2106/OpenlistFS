# OpenListFS configuration (copy to .env and fill in, or export these vars).
# Real credentials go in .env only — .env is git-ignored. Never commit tokens.

# Base URL of the OpenList server.
OPENLISTFS_URL=https://example.com

# Either an API token …
OPENLISTFS_TOKEN=

# … or username + password (a token is obtained via /api/auth/login at startup,
# and refreshed automatically on auth errors).
OPENLISTFS_USERNAME=
OPENLISTFS_PASSWORD=

# Proxy for ALL traffic to the server (API calls + file downloads):
#   "none" (default)  direct connections
#   "system"          Windows system proxy (Settings/WinINET registry,
#                     falling back to HTTP(S)_PROXY environment variables)
#   or a proxy URL    e.g. http://127.0.0.1:7897 or socks5://127.0.0.1:1080
# The `mount --proxy` flag and the GUI dropdown override this value.
OPENLISTFS_PROXY=

# auto (default), ipv4 or ipv6. With proxies, applies to the local proxy socket.
OPENLISTFS_IP_FAMILY=auto
